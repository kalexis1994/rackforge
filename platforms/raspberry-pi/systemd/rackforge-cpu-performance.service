[Unit]
Description=RackForge CPU performance governor for the audio path
# Ordered before the audio engine so the clock is already pinned when the
# first period is rendered, not shortly after the first dropout.
Before=rackforge-audio.service
ConditionPathIsDirectory=/sys/devices/system/cpu/cpu0/cpufreq

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/home/kalex/rackforge/sbin/rackforge-cpu-performance.sh apply
ExecStop=/home/kalex/rackforge/sbin/rackforge-cpu-performance.sh restore
Environment=RACKFORGE_APPLIANCE_STATE=/var/lib/rackforge/appliance
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectKernelModules=true
LockPersonality=true
RestrictAddressFamilies=

[Install]
WantedBy=multi-user.target
