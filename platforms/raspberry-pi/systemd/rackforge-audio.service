[Unit]
Description=RackForge supervised low-latency audio engine
After=local-fs.target sound.target rackforge-cpu-performance.service
Wants=sound.target rackforge-cpu-performance.service
Before=rackforge-platform-host.service rackforge-controller-host.service NetworkManager.service
StartLimitIntervalSec=0
ConditionPathExists=@RACKFORGE_ROOT@/config/audio.toml

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=20
User=@RACKFORGE_USER@
Group=@RACKFORGE_GROUP@
SupplementaryGroups=audio rackforge
Environment=RACKFORGE_ROOT=@RACKFORGE_ROOT@
WorkingDirectory=@RACKFORGE_ROOT@
ExecCondition=/usr/bin/test -f @RACKFORGE_ROOT@/config/audio.toml

# Real-time grant. The host requests SCHED_FIFO and mlockall on its audio
# thread; without these limits that request is refused and the engine keeps
# playing on the ordinary scheduler, where a page fault or a scheduling delay
# becomes an audible dropout. The host reports REALTIME_ENGAGED or
# REALTIME_DEGRADED at startup so the outcome is never silent.
#
# The ceiling is 95 rather than infinity: interrupt and watchdog kernel threads
# must still be able to preempt a runaway audio callback, otherwise one stuck
# buffer takes the whole board down mid-performance.
LimitRTPRIO=95
LimitMEMLOCK=infinity
# During boot, device discovery and plugin restoration compete with general OS
# services. cgroup startup weights prioritize this unit only until systemd
# finishes booting; the audio thread then owns its explicit SCHED_FIFO policy.
StartupCPUWeight=10000
StartupIOWeight=10000
Nice=-10
ExecStart=@RACKFORGE_ROOT@/bin/rackforge-core resume @RACKFORGE_ROOT@/config/audio.toml
Restart=always
RestartSec=1
TimeoutStopSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@RACKFORGE_ROOT@/data @RACKFORGE_ROOT@/state @RACKFORGE_ROOT@/logs
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
