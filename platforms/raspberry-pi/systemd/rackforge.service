[Unit]
Description=rackforge headless instrument engine
After=local-fs.target sound.target
Wants=sound.target

[Service]
Type=simple
User=@RACKFORGE_USER@
Group=@RACKFORGE_GROUP@
WorkingDirectory=@RACKFORGE_ROOT@/current
ExecStart=@RACKFORGE_ROOT@/current/target/release/rackforge-daemon
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=@RACKFORGE_ROOT@

[Install]
WantedBy=multi-user.target
