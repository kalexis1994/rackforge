+// Coefficient-major prepared carriers keep each modal coefficient contiguous.
+// Preparation preserves the original recurrence and floating-point order.
+struct RampPlan {
+    columns: [Vec<f64>; 10],
+    size: usize,
+}
+impl RampPlan {
+    fn new(size: usize) -> Self {
+        Self {
+            columns: std::array::from_fn(|_| vec![0.; 65 * size]),
+            size,
+        }
+    }
+    fn coefficients(&self, frames: usize, j: usize) -> [f64; 10] {
+        std::array::from_fn(|k| self.columns[k][frames * self.size + j])
+    }
+    fn span(&self, frames: usize, start: usize, end: usize) -> [&[f64]; 10] {
+        std::array::from_fn(|k| {
+            &self.columns[k][frames * self.size + start..frames * self.size + end]
+        })
+    }
+}
+
