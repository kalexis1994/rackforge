[Unit]
Description=RackForge local web interface
After=local-fs.target

[Service]
Type=simple
User=kalex
Group=kalex
Environment=RACKFORGE_ROOT=/home/kalex/rackforge
Environment=RACKFORGE_WEB_ROOT=/home/kalex/rackforge/web
ExecStart=/home/kalex/rackforge/bin/rackforge-web
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/kalex/rackforge/config /home/kalex/rackforge/state /home/kalex/rackforge/plugin-store
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
