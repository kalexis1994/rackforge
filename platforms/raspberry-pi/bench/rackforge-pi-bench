                      52, 57, 71, 76, 83, 86, 48, 53, 88, 91],
        },
        {
            "label": "rf-musette-student-72",
            "instance": "play.org.rackforge.musette",
            "sound": "student-72",
            "notes": [60, 64, 67, 72, 55, 59, 62, 65, 69, 74, 77, 79, 81, 84,
                      57, 71, 76, 83, 86, 88, 91, 53, 54, 56],
        },
        {
            "label": "rf-5-slow-strings",
            "instance": "play.org.rackforge.rf-5",
            "sound": "file2-26-slow-strings",
            "notes": [60, 64, 67, 72, 55, 59, 62, 65, 69, 74, 77, 79, 81, 84,
                      52, 57, 71, 76, 83, 86, 48, 53, 88, 91],
        },
        {
            "label": "rf-organ-straight-888",
            "instance": "play.org.rackforge.organ",
            "sound": "straight-888",
            "notes": [60, 64, 67, 72, 55, 59, 62, 65, 69, 74, 77, 79, 81, 84,
