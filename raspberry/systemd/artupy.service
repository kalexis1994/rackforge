[Unit]
Description=artupy headless instrument engine
After=local-fs.target sound.target
Wants=sound.target

[Service]
Type=simple
User=kalex
Group=kalex
WorkingDirectory=/home/kalex/artupy/current
ExecStart=/home/kalex/artupy/current/target/release/artupy-daemon
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/kalex/artupy

[Install]
WantedBy=multi-user.target
