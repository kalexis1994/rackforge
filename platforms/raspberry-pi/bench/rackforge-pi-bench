#!/usr/bin/env python3
"""Measure a RackForge appliance the same way every time.

Runs on the Pi, as the RackForge user or root. Standard library only.

  rackforge-pi-bench audit [--json]
      What the engine and the system are actually doing: every engine
      thread's policy, priority, nice and CPUs; locked and resident memory;
      governors, temperature, throttling; where the USB, network and storage
      interrupts land; swap. Read from /proc and /sys, never from a marker.

  rackforge-pi-bench perform [--plan standard] [--hold 20] [--out FILE]
      A scripted performance through the control socket: per instrument, a
      polyphony ramp, each step held and re-struck. Records the engine's
      health counters, its render telemetry, memory, faults and temperature
      per step, and the most voices each instrument held with nothing late.
      Restores the instrument and program that were selected.

  rackforge-pi-bench boot-time [--json]
      For the current boot: when the kernel started the engine, when the
      engine first played a period, when the interface and SSH listened,
      when the network came up.

  rackforge-pi-bench compare BEFORE.json AFTER.json
      The two records side by side.
"""

import argparse
import datetime
import json
import os
import platform
import re
import socket
import subprocess
import sys
import time

ROOT = os.environ.get("RACKFORGE_ROOT", os.path.expanduser("~/rackforge"))
SOCKET = os.environ.get(
    "RACKFORGE_CONTROL_SOCKET", os.path.join(ROOT, "state", "live-control.sock")
)
UNIT = "rackforge-audio.service"
SESSION_SCHEMA_VERSION = 14
CLIENT = "rackforge-pi-bench"

# Each entry: instance, program, and the note pool the ramp draws from in
# order, so voice N is always the same key. The pools stay inside each
# instrument's range: the accordion's treble is F3-A6.
